# ==========================================
# TESTES DO MÓDULO DE HORÁRIOS DE PROFISSIONAIS (ISSUE #11)
# ==========================================
@baseURL = http://localhost:3000
@schedule_id = 16
@professional_id = 1

# ==========================================
# CENÁRIOS DE SUCESSO (VALIDAÇÕES DA ISSUE #11)
# ==========================================

### Listar todos os horários
GET {{baseURL}}/schedules
Accept: application/json

### Listar todos os horários filtrados por profissional
# FAZER
GET {{baseURL}}/schedules?professional_id={{professional_id}}
Accept: application/json

### Criar um novo horário com sucesso
POST {{baseURL}}/schedules
Content-Type: application/json

{
    "professional_id": 2,
    "weekday": 5,
    "start_hour": "19:00:00",
    "end_hour": "23:00:00"
}

### Atualizar um horário existente (substitua @schedule_id)
PUT {{baseURL}}/schedules/{{schedule_id}}
Content-Type: application/json

{
    "professional_id": 2,
    "weekday": 4,
    "start_hour": "04:00:00",
    "end_hour": "08:00:00"
}

### Deletar um horário existente (substitua @schedule_id)
DELETE {{baseURL}}/schedules/{{schedule_id}}
Accept: application/json

# ==========================================
# CENÁRIOS DE ERRO (VALIDAÇÕES DA ISSUE #11)
# ==========================================

# ------------------------------------------
# TESTES DE CRIAÇÃO (POST)
# ------------------------------------------

### [400 Bad Request] Criar serviço sem passá-lo
POST {{baseURL}}/schedules
Content-Type: application/json

{}

### [400 Bad Request] Criar serviço sem passar os campos obrigatórios
POST {{baseURL}}/schedules
Content-Type: application/json

{
    "campo_inexistente": ""
}

### [400 Bad Request] Criar serviço com id de profissional inválido (erro esperado)
POST {{baseURL}}/schedules
Content-Type: application/json

{
    "professional_id": "Samuel",
    "weekday": 4,
    "start_hour": "04:00:00",
    "end_hour": "08:00:00"
}

### [404 Not Found] Criar serviço com id de profissional válido, mas inexistente (erro esperado)
POST {{baseURL}}/schedules
Content-Type: application/json

{
    "professional_id": 9999,
    "weekday": 4,
    "start_hour": "04:00:00",
    "end_hour": "08:00:00"
}

### [400 Bad Request] Criar serviço com todos os campos inválidos (erro esperado)
POST {{baseURL}}/schedules
Content-Type: application/json

{    
    "professional_id": "Samuel",
    "weekday": 7,
    "start_hour": 4.30,
    "end_hour": 8.00
}

### [409 Conflict] Criar serviço com name repetido (erro esperado)
.. VERIFICAR
    POST {{baseURL}}/schedules
    Content-Type: application/json
..
.. {
    "name": "Corte de Cabelo",
    "area_id": 1,
    "min_duration": 30,
    "price": 50.00
.. }

