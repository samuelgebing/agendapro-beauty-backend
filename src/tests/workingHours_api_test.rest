# ==========================================
# TESTES DO MÓDULO DE HORÁRIOS DO PROFISSIONAL
# ==========================================
@baseURL = http://localhost:3000
@working_hour_id = 28
@professional_id = 1

# ==========================================
# CENÁRIOS DE SUCESSO
# ==========================================

### Listar todos os horários
GET {{baseURL}}/works
Accept: application/json

### Listar horário por id 
GET {{baseURL}}/works/1
Accept: application/json

### Listar todos os horários filtrados pelo profissional
GET {{baseURL}}/works?professional_id={{professional_id}}
Accept: application/json

### Listar todos os horários filtrados pelo profissional e pela data
GET {{baseURL}}/works?professional_id={{professional_id}}&weekday=2
Accept: application/json

### Criar um novo horário com sucesso
POST {{baseURL}}/works
Content-Type: application/json

{
    "professional_id": 4,
    "weekday": 2,
    "start_hour": "09:00",
    "end_hour": "11:00"
}

### Atualizar um horário existente (substitua @professional_id)
PUT {{baseURL}}/works/{{working_hour_id}}
Content-Type: application/json

{
    "professional_id": 3,
    "weekday": 3,
    "start_hour": "09:30",
    "end_hour": "12:00"
}

### Deletar um horário existente (substitua @working_hour_id)
DELETE {{baseURL}}/works/{{working_hour_id}}
Accept: application/json

