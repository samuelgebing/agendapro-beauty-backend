# Senha para o login (a inserção do usuário retorna encriptado)
@password_hash = $3nh@_TESTE

# ==========================================
# CENÁRIOS DE SUCESSO (Papel 1 - profissional)
# ==========================================

### Criar um novo usuário
# @name user
POST {{baseURL}}/users
Content-Type: application/json

{
    "name": "Profissional teste",
    "email": "profissional_teste@example.com",
    "password_hash": "{{password_hash}}",
    "role_id": 2
}

### Logar e pegar o token
# @name login
POST {{baseURL}}/users/login
Content-Type: application/json

{
    "email": "{{user.response.body.data.email}}",
    "password_hash": "{{password_hash}}"
}

### Criar um novo profissional vinculado ao usuario
# @name professional
POST {{baseURL}}/professionals
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "name": "Profissional teste",
    "speciality_id": 1,
    "phone": "(54) 99999-9999",
    "active": 1
}

# ==========================================
# ROTAS DE CRIAÇÃO - CREATE
# ==========================================

### FAZER: a proibição
### FORBIDDEN/UNAUTHORIZED: Criar um novo profissional com sucesso
# @name professional_create
POST {{baseURL}}/professionals
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "name": "Profissional teste para agendamentos",
    "speciality_id": 1,
    "phone": "(54) 99999-9999",
    "active": 2
}

# FAZER: a proibição
### FORBIDDEN/UNAUTHORIZED: Criar um novo usuário
# @name client_create
POST {{baseURL}}/users
Content-Type: application/json

{
    "name": "Cliente teste para agendamentos",
    "email": "cliente_teste_agendamentos@example.com",
    "password_hash": "{{password_hash}}",
    "role_id": 1
}

### Criar um novo serviço com sucesso
# @name service_create
POST {{baseURL}}/services
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "name": "Tipo de serviço teste para agendamentos 2",
    "area_id": 1,
    "min_duration": 30,
    "price": 50.00
}

### Criar um novo horário com sucesso
# @name works_create
POST {{baseURL}}/works
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "professional_id": {{professional.response.body.data.id}},
    "weekday": 2,
    "start_hour": "09:00",
    "end_hour": "11:00"
}

### Criar um novo bloqueio de horário com sucesso
# @name block_create
POST {{baseURL}}/blocks
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "professional_id": {{professional.response.body.data.id}},
    "start": "2040-01-02 00:00",
    "end": "2040-01-31 23:59",
    "reason": "Motivo do bloqueio teste"
}

### FAZER: a proibição
### FORBIDDEN/UNAUTHORIZED: Criar um novo agendamento com sucesso
# @name schedule_create
POST {{baseURL}}/schedules
Authorization: Bearer {{login.response.body.data.token}}
Content-Type: application/json

{
    "user_id": {{user.response.body.data.id}},
    "professional_id": {{professional.response.body.data.id}},
    "service_id": {{service_create.response.body.data.id}},
    "start_date_hour": "2040-07-20 10:00:00",
    "end_date_hour": "2040-07-20 11:30:00"
}

